# Example environment for special-bot. Names only: never commit real values.
# The runtime file is `.environment` (and dated `.environment.bak.*` backups)
# and must stay out of version control.

# --- Telegram / payments ---
TELEGRAM_BOT_TOKEN=
YOUMONEY_TOKEN=

# In-bot support tickets. Numeric id of the operators' supergroup, e.g.
# -1001234567890. Zero (the default) keeps the current behaviour exactly: the
# menu button stays a plain link to the public support chat and no ticket
# handler is registered. Two manual steps are required before setting it, in
# this order:
#   1. Create a supergroup and turn Topics on in its settings.
#   2. Add the bot to it as an administrator with "Manage topics" allowed.
# Setting the id without both steps done leaves every first message failing on
# create_forum_topic — the user is told support is unavailable and no ticket is
# left behind, but nothing gets through until the group is fixed.
SUPPORT_CHAT_ID=0

# Where the "Карточка клиента" button in a support topic points. Only the scheme
# and host matter — the path to the customer comes from reverse(). Leave empty to
# drop the button; an invalid URL would make Bot API reject the whole keyboard,
# taking the close button with it.
ADMIN_BASE_URL=https://sub.special-wifi.ru/admin/

# --- Django ---
DJANGO_SETTINGS_MODULE=bot.settings
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,sub.special-wifi.ru

# --- PostgreSQL ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Optional: overrides the assembled values above.
DATABASE_URL=

# --- Redis / Celery ---
# Either set REDIS_URL directly, or set REDIS_PASSWORD (plus optional host/port/db).
# No password is hardcoded anywhere; an empty password means a passwordless local URL.
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=

# --- Subscription rollout (both default false) ---
SUBSCRIPTION_CONNECTOR_ENABLED=false
SUBSCRIPTION_DELIVERY_ENABLED=false
SUBSCRIPTION_BASE_URL=

# External backup subscriptions (feature-gated). Bearer URLs live only in a
# mode-0600 JSON file on an absolute host path outside this repository/build
# context, e.g. {"upstream_urls": ["https://provider.example.invalid/opaque-subscription-SYNTHETIC"], "allowed_line_sha256": ["0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"]}.
# allowed_line_sha256 is optional; when present it must contain lowercase SHA-256
# digests of exact UTF-8 VLESS lines. Rotate/revoke provider bearers at the provider;
# never store URLs or lines in Git.
SUBSCRIPTION_BACKUP_ENDPOINTS_ENABLED=false
SUBSCRIPTION_BACKUP_TEST_USER_IDS=[]
# Leave unset while disabled: Compose binds /dev/null, which settings rejects.
SUBSCRIPTION_BACKUP_SECRET_HOST_PATH=
# Optional JSON allowlist of exact upstream DNS names, e.g. ["provider.example"]
SUBSCRIPTION_BACKUP_UPSTREAM_HOSTS=[]
SUBSCRIPTION_BACKUP_CONNECT_TIMEOUT_SECONDS=3
SUBSCRIPTION_BACKUP_READ_TIMEOUT_SECONDS=5
SUBSCRIPTION_BACKUP_RESPONSE_MAX_BYTES=262144
SUBSCRIPTION_BACKUP_CACHE_TTL_SECONDS=300
SUBSCRIPTION_BACKUP_MAX_SOURCES=8
SUBSCRIPTION_BACKUP_AGGREGATE_MAX_LINES=256
SUBSCRIPTION_BACKUP_AGGREGATE_MAX_BYTES=262144
SUBSCRIPTION_BACKUP_FETCH_DEADLINE_SECONDS=8
# Agent presented to providers that serve a different format per User-Agent.
# Empty keeps the neutral agent; e.g. SFI/1.9 selects a sing-box JSON config.
SUBSCRIPTION_BACKUP_UPSTREAM_USER_AGENT=
# Device identity presented to providers that require one (x-hwid and the
# optional description headers). Without it such a provider answers with an
# "unsupported application" notice instead of a configuration. Shape:
# ^[a-zA-Z0-9=-]{10,64}$. Use ONE stable value per installation — a value that
# changes per user or per request looks like a device flood and gets blocked.
SUBSCRIPTION_BACKUP_UPSTREAM_HWID=
SUBSCRIPTION_BACKUP_UPSTREAM_DEVICE_OS=
SUBSCRIPTION_BACKUP_UPSTREAM_OS_VERSION=
SUBSCRIPTION_BACKUP_UPSTREAM_DEVICE_MODEL=
# Serve provider endpoints that have neither TLS nor Reality. Off by default:
# plain VLESS exposes the client UUID on the wire and is trivially blocked.
SUBSCRIPTION_BACKUP_ALLOW_PLAINTEXT_ENDPOINTS=false

# Same-origin internal inbound transport canary. Entries contain only public
# routing metadata, e.g. [{"inbound_id":7,"advertised_port":39329,"label":"🇳🇱 NL TCP 39329"}].
# Keep disabled unless the live per-inbound membership and expiry gates are ready.
SUBSCRIPTION_INTERNAL_INBOUNDS_ENABLED=false
SUBSCRIPTION_INTERNAL_MEMBERSHIP_SYNC_ENABLED=false
SUBSCRIPTION_INTERNAL_TEST_USER_IDS=[]
SUBSCRIPTION_INTERNAL_ENDPOINTS=[]

# Per-subscription device binding on the ``x-hwid`` header. Strict mode refuses
# clients that send no usable identifier; keep it false until the fleet sends one.
SUBSCRIPTION_DEVICE_LIMIT=2
SUBSCRIPTION_HWID_STRICT=false
SUBSCRIPTION_DEVICE_RESET_COOLDOWN_HOURS=1
# The subscription endpoint is unauthenticated, so binding a *new* identifier
# normally requires the account holder to open a window from the bot.
# Set WINDOW_REQUIRED=false for the first ~48 hours of the rollout ONLY: on the
# day of deploy nobody has a bound device yet, and requiring a window at once
# would refuse the second device of every existing customer. Once real fleets
# have bound their real devices, set it back to true — that is what closes the
# path where a leaked sub_id fills the slots and locks the customer out. False
# is a temporary launch state, never the steady state; the example ships true so
# nothing lands in the weak mode by default. The limit and the hourly
# registration budget apply in both states.
SUBSCRIPTION_DEVICE_BINDING_WINDOW_REQUIRED=true
SUBSCRIPTION_DEVICE_BINDING_WINDOW_MINUTES=15
SUBSCRIPTION_DEVICE_REGISTRATIONS_PER_HOUR=5

# --- Monitoring (all default off; enable only by reviewed rollout) ---
SPECIAL_MONITOR_ENABLED=false
SPECIAL_MONITOR_L2_ENABLED=false
SPECIAL_MONITOR_PROBE_REGION=
SPECIAL_MONITOR_FAILURE_THRESHOLD=2
# Provider-neutral HTTPS webhook. Keep disabled until a channel and on-call owner exist.
SPECIAL_MONITOR_PAGING_ENABLED=false
SPECIAL_MONITOR_PAGING_WEBHOOK_URL=
SPECIAL_MONITOR_PAGING_OWNER=
SPECIAL_MONITOR_PAGING_TIMEOUT=10
# Host-capacity thresholds; monitoring records aggregate values only.
SPECIAL_MONITOR_MIN_AVAILABLE_MB=128
SPECIAL_MONITOR_MIN_SWAP_MB=512
SPECIAL_MONITOR_MAX_LOAD_PER_CPU=4.0
SPECIAL_MONITOR_MAX_OOM_KILLS=0
# JSON arrays. Endpoint labels and expected inbound properties only, no credentials.
SPECIAL_MONITOR_ENDPOINTS=[]
SPECIAL_MONITOR_EXPECTED_INBOUNDS=[]
# L2 fails closed unless the canary id, a valid expected egress IP and an HTTPS
# health URL without embedded credentials are all present.
SPECIAL_MONITOR_CANARY_USER_VPN_ID=0
SPECIAL_MONITOR_EXPECTED_EGRESS=
SPECIAL_MONITOR_HEALTH_URL=https://api.ipify.org
SPECIAL_MONITOR_XRAY_PATH=/usr/local/bin/xray

# Scale/failover metadata uses the single canonical schema documented by
# ops/origins.example.json. Real inventory belongs in approved runtime/operator
# storage, not this environment file.
